kind: eos_sb_signer
description: |
  Sign the GRUB UEFI bootloader binary with UEFI Secure Boot signatures.

  This element takes the GRUB EFI binary from grub-x86_64-efi.bst and sends it
  to the eos-sb-signer service for signing. The signed binary is then available
  for inclusion in disk images with Secure Boot support.

build-depends:
- eos/grub/grub-x86_64-efi.bst

config:
  # Path to the GRUB EFI binary in the dependency.
  input: /usr/lib/efi_binaries/EFI/endless/grubx64.efi

  # Output path for the signed binary (same location by default).
  output: /usr/lib/efi_binaries/EFI/endless/grubx64.efi

  # Signing service endpoint.
  # For production builds, this should point to the official signing service.
  # For local development, you can run a local instance of eos-sb-signer.
  endpoint: http://localhost:5000

  # Path to an existing signature file (required).
  # This should point to a signature file generated by your key management process.
  # For example, it could come from a previous signing step or be provided as a source.
  signature_path: /usr/lib/efi_binaries/EFI/endless/grubx64.efi.sig

  # Request timeout in seconds.
  timeout: 30
