kind: eos_sb_signer
description: |
  Sign the Linux kernel binary with UEFI Secure Boot signatures.

  This element takes the kernel binary from the Linux build and sends it
  to the eos-sb-signer service for signing. The signed kernel is required
  for systems with UEFI Secure Boot enabled.

build-depends:
- freedesktop-sdk.bst:components/linux.bst

config:
  # Path to the kernel binary in the dependency.
  # The exact path may vary based on the kernel version and configuration.
  input: /boot/vmlinuz

  # Output path for the signed kernel.
  output: /boot/vmlinuz-signed

  # Signing service endpoint.
  # For production builds, this should point to the official signing service.
  # For local development, you can run a local instance of eos-sb-signer.
  endpoint: http://localhost:5000

  # Path to an existing signature file (required).
  # This should point to a signature file generated by your key management process.
  signature_path: /boot/vmlinuz.sig

  # Request timeout in seconds.
  timeout: 60